# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (defaults are sensible)
HARNESS_MODEL=claude-opus-4-7
HARNESS_JUDGE_MODEL=claude-sonnet-4-6
HARNESS_SUBAGENT_MODEL=claude-haiku-4-5

# Generation
HARNESS_MAX_TOKENS=16000
HARNESS_EFFORT=high
HARNESS_THINKING=adaptive

# Loop control
HARNESS_MAX_ITERATIONS=25
HARNESS_PARALLEL_TOOLS=true

# State + logs
HARNESS_CHECKPOINT_DB=./.harness/checkpoints.db
HARNESS_LOG_LEVEL=INFO

# Optional backends
# REDIS_URL=redis://localhost:6379/0
# VECTOR_DB_URL=http://localhost:8000

# Guardrails
HARNESS_PII_SCRUB=true
HARNESS_ALLOWED_TOOLS=*
